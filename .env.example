# 复制本文件为 .env 并填入真实值。.env 永不入库（见 .gitignore）。
APP_NAME=健身AI Agent
DATABASE_URL=sqlite+aiosqlite:///./fitness.db
JWT_SECRET=请改成随机长字符串
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# LLM 供应商（reasoning=文本大脑, vision=识图, embedding=向量）
# 可选：fake（无 key 即可跑通） / deepseek / qwen / openai
# 切换模型只改这里，业务代码不变
# 注意：provider 名即决定用哪组 key —— deepseek→DEEPSEEK_*，qwen→QWEN_*，openai→OPENAI_*
REASONING_PROVIDER=fake
VISION_PROVIDER=fake
EMBEDDING_PROVIDER=

# 按用途的模型覆盖（可选；不填则用对应 provider 的默认 *_MODEL）
# 例：reasoning 用 deepseek 时想换 deepseek-reasoner，可填 REASONING_MODEL=deepseek-reasoner
REASONING_MODEL=
VISION_MODEL=
EMBEDDING_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
