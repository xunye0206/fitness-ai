# 复制本文件为 .env 并填入真实值。.env 永不入库（见 .gitignore）。
APP_NAME=健身AI Agent

# 数据库：本地/测试用 SQLite（零运维）；生产改为托管云 Postgres 连接串。
# 生产示例（注意带 +asyncpg 异步驱动后缀）：
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/fitness
DATABASE_URL=sqlite+aiosqlite:///./fitness.db

# Redis：agent 上下文热缓存 + 推送 ≤3/天 限流。留空则不启用（自动降级，不拖主链路）。
# 生产示例：REDIS_URL=redis://host:6379/0
REDIS_URL=

# 图片存储（生产上线必配，否则图片写本地盘、redeploy 丢图）：
# 配齐 SUPABASE_URL / SUPABASE_KEY / SUPABASE_BUCKET 后，上传图片走 Supabase Storage（持久）。
# bucket 须设为 Public；未配置则降级写本地盘 data/uploads（仅限本地/测试）。
# 获取：Supabase 控制台 → Project Settings → API 里的 URL 与 anon/public key。
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=fitness-uploads

# embedding 向量维度（须与 EMBEDDING_MODEL 一致；Qwen text-embedding-v3 默认 1024）
EMBEDDING_DIM=1024

JWT_SECRET=请改成随机长字符串
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# LLM 供应商（reasoning=文本大脑, vision=识图, embedding=向量）
# 可选：fake（无 key 即可跑通） / deepseek / qwen / openai
# 切换模型只改这里，业务代码不变
# 注意：provider 名即决定用哪组 key —— deepseek→DEEPSEEK_*，qwen→QWEN_*，openai→OPENAI_*
REASONING_PROVIDER=fake
VISION_PROVIDER=fake
# 记忆检索层（M5）：推荐阿里云 Qwen text-embedding-v3（复用 qwen 的 key/base_url）。
# 部署上线时取消下面两行注释即可启用向量记忆：
# EMBEDDING_PROVIDER=qwen
# EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_PROVIDER=

# 按用途的模型覆盖（可选；不填则用对应 provider 的默认 *_MODEL）
# 例：reasoning 用 deepseek 时想换 deepseek-reasoner，可填 REASONING_MODEL=deepseek-reasoner
REASONING_MODEL=
VISION_MODEL=
EMBEDDING_MODEL=

# embedding 专用端点（可选）。默认复用 EMBEDDING_PROVIDER 的 base_url。
# 若你的 MaaS 端点不支持 /embeddings，取消注释并指向 DashScope 主站 compatible-mode：
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ---- Agent 行为开关 ----
# M10 长期画像记忆总开关：false 则既不抽取也不召回用户画像（回退无个性化）
PROFILE_MEMORY_ENABLED=true
# 合规 LLM 语义复核（里程碑2增强）：false 则仅用关键词黑名单，省一次 LLM 调用
COMPLIANCE_LLM_CHECK=true
